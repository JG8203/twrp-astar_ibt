#
# Loads the kernel modules the recovery needs. The module binaries are the
# stock ones extracted from the RQ-713 recovery ramdisk so they match the
# stock zImage exactly (same vermagic: 3.4.39 SMP preempt mod_unload modversions).
#
# sw-device.ko must come before gslX680new.ko, disp.ko before lcd.ko.
#

on init
    insmod /nand.ko
    insmod /sw-device.ko debug_mask=0xff ctp_mask=1
    insmod /sunxi-keyboard.ko
    insmod /disp.ko
    insmod /lcd.ko
    insmod /gslX680new.ko

service console /sbin/sh
    class core
    console
    disabled
    user shell
    group shell log
    seclabel u:r:shell:s0
